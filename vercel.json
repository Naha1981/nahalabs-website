{
  "rewrites": [
    {
      "source": "/li",
      "destination": "/api/li"
    },
    {
      "source": "/audit",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/revenuedesk",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/systems",
      "destination": "/index.html"
    },
    {
      "source": "/press",
      "destination": "/index.html"
    },
    {
      "source": "/insights",
      "destination": "/index.html"
    },
    {
      "source": "/insights/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/locations/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/services/revenue-leak-audit-johannesburg",
      "destination": "/services/revenue-leak-audit-johannesburg.html"
    },
    {
      "source": "/cargo-iq",
      "destination": "/index.html"
    },
    {
      "source": "/nutri-tummies",
      "destination": "/index.html"
    },
    {
      "source": "/gtg",
      "destination": "/index.html"
    },
    {
      "source": "/railwatch",
      "destination": "/index.html"
    },
    {
      "source": "/netpulse",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/np",
      "destination": "/netpulse?utm_source=outreach&utm_medium=direct&utm_campaign=netpulse",
      "permanent": false
    },
    {
      "source": "/services/lead-follow-up-automation-johannesburg",
      "destination": "/revenuedesk",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
